# ---------------------------------------------------------------------------
# TranslateBook AI — copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- Database (matches docker-compose.yml) ---------------------------------
# Port 5433, not 5432: a locally installed PostgreSQL usually already owns 5432.
DATABASE_URL=postgresql+asyncpg://translatebook:translatebook@localhost:5433/translatebook
DB_PORT=5433

# --- LLM provider ----------------------------------------------------------
# github | anthropic | openai | ollama | fake
# `fake` is a deterministic offline provider used by the test suite; it needs
# no keys and costs nothing, but produces placeholder translations.
LLM_PROVIDER=github

# GitHub Models (free tier, default). Create a fine-grained PAT with the
# "Models" permission at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_BASE_URL=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4.1

# Anthropic — requires `uv sync --extra anthropic`
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Ollama (fully local, zero cost) — requires `uv sync --extra ollama`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Model used for vision calls (scanned-page OCR + extraction verification).
# Must be a multimodal model available on the active provider.
VISION_MODEL=openai/gpt-4.1
# Embedding model used for glossary semantic search (1536 dims expected).
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Pipeline tuning -------------------------------------------------------
# Mean OCR confidence below this escalates the page to vision-LLM OCR.
OCR_CONFIDENCE_THRESHOLD=0.75
# Verification score below this re-runs translation with the suggestions applied.
VERIFICATION_THRESHOLD=0.85
MAX_TRANSLATION_RETRIES=2
# Soft chunk budget in characters for prose; poetry/verse/hadith use less.
CHUNK_TARGET_CHARS=1200
# How many chunks translate concurrently.
TRANSLATION_CONCURRENCY=3
# Set to false to skip the extra vision call that checks extraction fidelity.
ENABLE_EXTRACTION_VERIFIER=true

# --- Storage ---------------------------------------------------------------
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
# Defaults to ../prompts relative to the backend package.
# PROMPTS_DIR=

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
