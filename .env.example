# ---------------------------------------------------------------------------
# TranslateBook AI — copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- Database (matches docker-compose.yml) ---------------------------------
# Port 5433, not 5432: a locally installed PostgreSQL usually already owns 5432.
DATABASE_URL=postgresql+asyncpg://translatebook:translatebook@localhost:5433/translatebook_v2
TEST_DATABASE_URL=postgresql+asyncpg://translatebook:translatebook@localhost:5433/translatebook_test
DB_PORT=5433

# --- Server ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8010
# true = the API process also runs the job worker (one-command dev).
# false = run `uv run python -m app.worker` separately (production).
WORKER_INLINE=true

# --- LLM provider ----------------------------------------------------------
# github | openai | anthropic | nvidia | ollama | fake
# `fake` is a deterministic offline provider used by tests and demo mode; it
# needs no keys and costs nothing, but produces placeholder translations.
# If the chosen provider has no key the app logs a warning and uses `fake`.
LLM_PROVIDER=github

# GitHub Models (free tier). Fine-grained PAT with the "Models" permission:
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_BASE_URL=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4.1
# Any other OpenAI-compatible host works here too, e.g. OpenRouter:
# GITHUB_BASE_URL=https://openrouter.ai/api/v1  GITHUB_TOKEN=<openrouter key>

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Anthropic — requires `uv sync --extra anthropic`
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Ollama (fully local, zero cost) — requires `uv sync --extra ollama`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4000

# --- Pipeline tuning -------------------------------------------------------
# Mean EasyOCR confidence below this drops the line (vision OCR has no score).
OCR_CONFIDENCE_THRESHOLD=0.75
# Verification score below this re-runs translation with the reviewer's notes.
VERIFICATION_THRESHOLD=0.8
MAX_TRANSLATION_RETRIES=1
# Soft chunk budget in characters for prose.
CHUNK_TARGET_CHARS=1200
# How many chunks translate concurrently.
TRANSLATION_CONCURRENCY=3
# LangGraph checkpointer for mid-chunk resume: postgres | memory | none.
# On Windows the API must run with --loop app.core.eventloop:new_event_loop (make api does).
CHECKPOINTER=postgres
# A running job with no heartbeat for this long is re-queued (worker died).
JOB_STALE_SECONDS=600
# Content types copied through untouched (comma separated).
PASSTHROUGH_CONTENT_TYPES=quranic_verse

# --- Storage ---------------------------------------------------------------
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
