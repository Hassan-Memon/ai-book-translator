# ---------------------------------------------------------------------------
# TranslateBook AI — copy to .env and fill in. .env is gitignored.
#
# You do NOT need to edit the LLM section: open Settings in the app, pick a
# provider, paste your key (or point it at Ollama / LM Studio on your laptop)
# and press "Test connection". Values saved there override this file.
# ---------------------------------------------------------------------------

# --- Database (matches docker-compose.yml) ---------------------------------
# Port 5433, not 5432: a locally installed PostgreSQL usually already owns 5432.
DATABASE_URL=postgresql+asyncpg://translatebook:translatebook@localhost:5433/translatebook_v2
TEST_DATABASE_URL=postgresql+asyncpg://translatebook:translatebook@localhost:5433/translatebook_test
DB_PORT=5433

# --- Server ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8010
# true = the API process also runs the job worker (one-command dev).
# false = run `uv run python -m app.worker` separately (production).
WORKER_INLINE=true
# Encrypts API keys saved from the Settings screen. Leave empty to auto-generate
# one into backend/data/.secret_key. Set it explicitly in production.
SECRET_KEY=
# When the API is reachable from the internet (Cloudflare Tunnel, docs/CLOUDFLARE.md),
# /api calls from outside this machine must send this in X-TranslateBook-Key.
# `python deploy/cloudflare/connect.py setup` generates it. Empty = not enforced.
API_SHARED_SECRET=

# --- LLM provider (defaults; the Settings screen can override) -------------
# ollama | lmstudio | openai_compatible | github | openai | anthropic | gemini |
# openrouter | groq | deepseek | mistral | together | nvidia | fake
# `fake` is a deterministic offline provider used by tests and demo mode; it
# needs no keys and costs nothing, but produces placeholder translations.
# If the chosen provider has no key the app logs a warning and uses `fake`.
LLM_PROVIDER=ollama

# Local models (free, private). See docs/LOCAL_MODELS.md for what to pull.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
# Any other OpenAI-compatible server (vLLM, llama.cpp, LocalAI, a gateway).
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Cloud providers: set the key for the one you use.
GITHUB_TOKEN=
GITHUB_BASE_URL=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# A separate multimodal model for OCR of scanned pages (optional). With Ollama,
# e.g. VISION_MODEL=qwen2.5vl:7b. Empty = use the chat model if it has vision.
VISION_MODEL=

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4000

# --- OCR (free, no model required; see docs/OCR.md) ------------------------
# auto | tesseract | mupdf | easyocr | vision | none
OCR_ENGINE=auto
OCR_DPI=300
# Download missing Tesseract language packs on first use (tessdata_best).
OCR_DOWNLOAD_PACKS=true
OCR_PACK_REPO=best
# Pages scoring below this are re-read by the vision model (if one is configured).
OCR_ESCALATION_THRESHOLD=0.7
# When to use the vision model for OCR: auto (poor pages only) | always | off
OCR_VISION=auto
# Extra languages to recognise alongside the source, comma separated (e.g. en,ar).
OCR_EXTRA_LANGUAGES=
# Ask the text LLM to repair OCR noise before translating: auto | always | off
OCR_LLM_CLEANUP=auto
OCR_CLEANUP_THRESHOLD=0.85
# Lines below this Tesseract confidence are dropped when they are 1-2 chars long.
OCR_CONFIDENCE_THRESHOLD=0.75

# --- Agent strategy (see docs/AGENT_STRATEGY.md) --------------------------
# auto | fast | balanced | thorough. auto = thorough for small models, else balanced.
QUALITY_PROFILE=auto
# Numbered sentences in, numbered sentences out: auto | on | off
SENTENCE_ALIGNMENT=auto
# Sample N translations per chunk and keep the best (free on local models). 1 = off.
TRANSLATION_CANDIDATES=1
# Approved chunks of the same book used as in-context examples.
TRANSLATION_MEMORY_EXAMPLES=3
# Fluency pass after verification: auto | on | off
POLISH_PASS=auto
# Verification score below this re-runs translation with the reviewer's notes.
VERIFICATION_THRESHOLD=0.8
MAX_TRANSLATION_RETRIES=1
# Soft chunk budget in characters for prose (smaller models get less automatically).
CHUNK_TARGET_CHARS=1200
# How many chunks translate concurrently (keep at 1-2 for a laptop model).
TRANSLATION_CONCURRENCY=3
# LangGraph checkpointer for mid-chunk resume: postgres | memory | none.
# On Windows the API must run with --loop app.core.eventloop:new_event_loop (make api does).
CHECKPOINTER=postgres
# A running job with no heartbeat for this long is re-queued (worker died).
JOB_STALE_SECONDS=600
# Content types copied through untouched (comma separated).
PASSTHROUGH_CONTENT_TYPES=quranic_verse

# --- Storage ---------------------------------------------------------------
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
TESSDATA_DIR=./data/tessdata

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
